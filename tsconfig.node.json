{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "cli/**/*.mts",
    "examples/**/*.mts",
    "scripts/**/*.mts",
    "test/node/**/*.mts",
    "vitest.config.ts"
  ]
}
