{
  "name": "redpixels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted email open history and signed webhooks for Gmail.",
  "license": "MIT",
  "repository": "github:arkorlab/redpixels",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "gmail": "node --experimental-strip-types cli/gmail.mts",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "dev:cf": "cf dev",
    "deploy:cf": "cf deploy",
    "build:cf": "cf deploy --dry-run",
    "dev:wrangler": "wrangler dev --config wrangler.toml",
    "deploy:wrangler": "wrangler deploy --config wrangler.toml",
    "build:wrangler": "wrangler deploy --config wrangler.toml --dry-run --outdir dist",
    "check:cli-builds": "node --experimental-strip-types scripts/check-cli-builds.mts",
    "test": "vitest run && node --experimental-strip-types --test test/node/*.test.mts",
    "typecheck": "wrangler types worker-runtime.d.ts --config wrangler.toml --include-env false && tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.config.json",
    "check": "prettier --check . && pnpm typecheck",
    "format": "prettier --write .",
    "build": "wrangler deploy --config wrangler.toml --dry-run --outdir dist"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.3",
    "@types/node": "22.15.17",
    "cf": "1.0.0-beta.17",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.1",
    "google-auth-library": "11.3.1",
    "parse5": "8.0.1"
  }
}
